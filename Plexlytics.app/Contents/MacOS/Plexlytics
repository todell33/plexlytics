#!/bin/bash
# Plexlytics launcher -- this is what runs when you open the app from
# Launchpad, Spotlight, or /Applications. It's a thin launcher, not the
# server itself: the actual Plexlytics server runs continuously in the
# background via launchd (see the README), the same as before this existed.
# All this does is make sure that service is running, then open your
# browser to it -- so opening "Plexlytics" feels like opening a normal app,
# even though under the hood it's a local web page.

PORT="__PLEXLYTICS_PORT__"
LABEL="com.plexstats.app"
URL="http://127.0.0.1:${PORT}"
PLIST="$HOME/Library/LaunchAgents/com.plexstats.app.plist"

is_up() {
  curl -s -o /dev/null --max-time 1 "$URL"
}

if ! is_up; then
  # Make sure the service is actually loaded into launchd at all first --
  # harmless/idempotent if it already is (this fails silently and that's
  # fine). Without this, kickstart alone can't do anything if the service
  # was never bootstrapped in the first place (e.g. after a fresh install
  # where something about that step didn't take).
  if [ -f "$PLIST" ]; then
    launchctl bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1
  fi
  launchctl kickstart -k "gui/$(id -u)/${LABEL}" >/dev/null 2>&1

  # Poll instead of a fixed short sleep -- a fresh start (database
  # connection, background scheduler, Plex connection) can take longer
  # than a couple of seconds, especially right after a reboot.
  for i in $(seq 1 20); do
    is_up && break
    sleep 0.5
  done
fi

if is_up; then
  open "$URL"
else
  osascript -e "display alert \"Plexlytics isn't responding\" message \"The background service didn't start in time. Check /tmp/plexstats.err for details, or open Terminal and run: launchctl kickstart -k gui/$(id -u)/com.plexstats.app\" as critical"
fi
